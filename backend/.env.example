PORT=4000
# Must include ?replicaSet=rs0 — required for the multi-document transactions used in
# booking/quote creation. See CLAUDE.md for the one-time local replica-set setup.
MONGODB_URI="mongodb://localhost:27017/iffcargo?replicaSet=rs0"
JWT_SECRET="change-this-to-a-random-string"
JWT_EXPIRES_IN="24h"
BCRYPT_ROUNDS=12

# Carrier API keys (empty = use mock)
FEDEX_API_KEY=
FEDEX_SECRET_KEY=
FEDEX_ACCOUNT_NUMBER=
# XPO LTL: OAuth2 password grant (base64 consumer key:secret + portal user) and the Bill-To
# account rates are priced against. XPO_PD_ACCOUNT is a pickup/delivery account (not billable).
XPO_AUTH_KEY=
XPO_USERNAME=
XPO_PASSWORD=
XPO_BILL_ACCOUNT=
XPO_PD_ACCOUNT=
# XPO bookings (Bill of Lading + pickup): Y = XPO's test system, no truck is sent. Set N only
# when IFF is ready for real XPO pickups.
XPO_BOL_TEST_MODE=Y
DAYROSS_API_KEY=
DAYROSS_DIVISION=
MANITOULIN_API_KEY=
POLARIS_API_KEY=
POLARIS_ENVIRONMENT=

DAYROSS_ACCOUNT=
DAYROSS_EMAIL=
DAYROSS_PASSWORD=
DAYROSS_OAUTH_BASIC=
DAYROSS_ENVIRONMENT=
FEDEX_ENVIRONMENT=
FEDEX_CA_TEST_ACCOUNT=
# true only while running FedEx validation test cases; keep false otherwise
FEDEX_VALIDATION_MODE=false
DHL_USERNAME=
DHL_PASSWORD=
DHL_ACCOUNT_NUMBER=
DHL_IMPORT_ACCOUNT=
DHL_ENVIRONMENT=
CSA_USERNAME=
CSA_PASSWORD=
CSA_ENVIRONMENT=
ESTES_ACCOUNT_NUMBER=
ESTES_ENVIRONMENT=
ESTES_TEST_API_KEY=
ESTES_PROD_API_KEY=
ESTES_MYESTES_USERNAME=
ESTES_MYESTES_PASSWORD_TEST=
ESTES_MYESTES_PASSWORD_PROD=

# Address autocomplete on the quote form (Google Places API (New)). Leave empty to disable.
GOOGLE_PLACES_API_KEY=
# Regions suggestions are limited to (comma-separated ISO codes)
GOOGLE_PLACES_REGIONS=ca,us

# Sign-in (Auth0): the tenant domain and the API audience the frontend requests tokens for
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# QuickBooks (card payments and payment links). Sandbox only for now.
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_ENVIRONMENT=sandbox
# Must match a redirect URI registered in the Intuit app, e.g. https://api.example.com/api/quickbooks/callback
QB_REDIRECT_URI=
# Public address of the web app (QuickBooks sends admins back here after connecting)
FRONTEND_URL=http://localhost:3000

# Where spot-rate and guest quote request notices go
SPOT_RATE_NOTIFY_EMAIL=
# Carrier price corrections: absorbed below this amount, admin fee per charged correction, days to pay
ADJUSTMENT_THRESHOLD=10
ADJUSTMENT_ADMIN_FEE=0
ADJUSTMENT_PAYMENT_DAYS=14
# Background jobs (set to "off" to disable): monthly statements, QuickBooks payment-link checks
STATEMENTS_JOB=
PAYMENT_LINK_JOB=
