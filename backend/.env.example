PORT=4000
# Must include ?replicaSet=rs0 — required for the multi-document transactions used in
# booking/quote creation. See CLAUDE.md for the one-time local replica-set setup.
MONGODB_URI="mongodb://localhost:27017/iffcargo?replicaSet=rs0"
JWT_SECRET="change-this-to-a-random-string"
JWT_EXPIRES_IN="24h"
BCRYPT_ROUNDS=12

# Carrier API keys (empty = use mock)
FEDEX_API_KEY=
FEDEX_SECRET_KEY=
FEDEX_ACCOUNT_NUMBER=
# XPO LTL: OAuth2 password grant (base64 consumer key:secret + portal user) and the Bill-To
# account rates are priced against. XPO_PD_ACCOUNT is a pickup/delivery account (not billable).
XPO_AUTH_KEY=
XPO_USERNAME=
XPO_PASSWORD=
XPO_BILL_ACCOUNT=
XPO_PD_ACCOUNT=
# XPO bookings (Bill of Lading + pickup): Y = XPO's test system, no truck is sent. Set N only
# when IFF is ready for real XPO pickups.
XPO_BOL_TEST_MODE=Y
DAYROSS_API_KEY=
DAYROSS_DIVISION=
MANITOULIN_API_KEY=
POLARIS_API_KEY=
POLARIS_ENVIRONMENT=

# Address autocomplete on the quote form (Google Places API (New)). Leave empty to disable.
GOOGLE_PLACES_API_KEY=
# Regions suggestions are limited to (comma-separated ISO codes)
GOOGLE_PLACES_REGIONS=ca,us
